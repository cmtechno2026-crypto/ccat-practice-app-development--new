{
  "name": "@ccat/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CCAT secured Gateway — the sole student-data boundary (Blueprint §33).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/lib/migrate.ts",
    "seed": "tsx src/lib/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit",
    "seed:students": "tsx src/lib/seed-students.ts",
    "seed:content": "tsx src/lib/seed-content.ts",
    "seed:preview": "tsx src/lib/seed-preview.ts",
    "verify:core": "node --import tsx scripts/verify-core.ts",
    "provision:admin-auth": "node --import tsx scripts/provision-admin-auth.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.2.0",
    "fastify": "^5.2.0",
    "libphonenumber-js": "^1.13.11",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
