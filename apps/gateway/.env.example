# CCAT Gateway environment — copy to .env (gitignored) and fill the real secrets.
# ============================================================================
# SINGLE backing store: Supabase project `ccat-practice-app-development`
#   ref:    wazutprwrhnabjfggghp
#   region: ap-northeast-1 (Tokyo)   <-- see RESIDENCY NOTE in SUPABASE_WIRING.md
# The GATEWAY is the ONLY component with database credentials. Admin/Web/Mobile
# never hold the service_role key or a direct DB URL — they get only the gateway base URL.
# ============================================================================

# --- Database (the gateway connects directly to Postgres) -------------------
# USE THE SESSION POOLER: IPv4, Supavisor session mode, port 5432, username postgres.<ref>.
#   • The direct host db.<ref>.supabase.co is IPv6-ONLY on current Supabase projects, so it
#     fails on IPv4 deploy targets (getaddrinfo ENOTFOUND / unreachable).
#   • Do NOT use the TRANSACTION pooler (port 6543): it drops the `options=-c search_path`
#     connection-startup parameter the gateway pins (see apps/gateway/src/db.ts), which would
#     make every ccat.* table appear missing.
# TLS is required; the gateway also enables SSL automatically for any non-local host.
DATABASE_URL=postgresql://postgres.wazutprwrhnabjfggghp:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (IPv6 only; use only where the host has IPv6 or the Supabase IPv4 add-on):
#   postgresql://postgres:[YOUR-DB-PASSWORD]@db.wazutprwrhnabjfggghp.supabase.co:5432/postgres?sslmode=require
# Local-dev fallback (native Postgres, no Supabase — SSL auto-off for localhost):
#   postgresql://postgres:postgres@localhost:5432/ccat

# --- Supabase API (production Auth + private content Storage) ----------------
SUPABASE_URL=https://wazutprwrhnabjfggghp.supabase.co
# The Gateway uses the publishable key for ordinary password/TOTP Auth requests.
SUPABASE_PUBLISHABLE_KEY=[YOUR-PUBLISHABLE-KEY]
# Secret/service key is Gateway-only: private Storage + Admin Auth user lifecycle.
SUPABASE_SECRET_KEY=[YOUR-SECRET-KEY]
SUPABASE_STORAGE_BUCKET=ccat-content

# --- Gateway secrets --------------------------------------------------------
GATEWAY_HMAC_SECRET=change-me-in-prod
# IMPORTANT: the demo seed's admin password verifier was computed with this pepper.
# Keep it as 'dev-pepper' locally or the seeded admin logins won't work.
PIN_PEPPER=dev-pepper

# --- Runtime ----------------------------------------------------------------
NODE_ENV=local
PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080
STORAGE_DRIVER=local
