# Copy to .env.local. The ONLY config the web client needs: the gateway base URL.
# No Supabase key, no secrets, no service_role — the client talks only to the gateway.
VITE_GATEWAY_URL=http://localhost:8080

# Payments Phase 2 (entitlements + $50 gating). Default false. When false the app renders EXACTLY as
# today — no locks, no Upgrade UI, no /v1/entitlements/me call. Set to true ONLY on the payments preview.
VITE_PAYMENTS_ENABLED=false
