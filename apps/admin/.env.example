# Copy to .env.local. The ONLY config the admin client needs: the gateway base URL.
# No Supabase key, no secrets — the admin SPA talks only to the gateway.
VITE_GATEWAY_URL=http://localhost:8080

# Payments Phase 2 (entitlements + $50 gating). Default false. When false the Membership grant control
# is hidden and the admin renders EXACTLY as today. Set to true ONLY on the payments preview.
VITE_PAYMENTS_ENABLED=false
