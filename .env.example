# CCAT Gateway environment — copy to .env (gitignored) and fill the real secrets.
# ============================================================================
# SINGLE backing store: Supabase project `ccat-practice-app-development`
#   ref:    wazutprwrhnabjfggghp
#   region: ap-northeast-1 (Tokyo)   <-- see RESIDENCY NOTE in SUPABASE_WIRING.md
# The GATEWAY is the ONLY component with database credentials. Admin/Web/Mobile
# never hold the service_role key or a direct DB URL — they get only the gateway base URL.
# ============================================================================

# --- Database (the gateway connects directly to Postgres) -------------------
# USE THE SESSION POOLER: IPv4, Supavisor session mode, port 5432, username postgres.<ref>.
#   • The direct host db.<ref>.supabase.co is IPv6-ONLY on current Supabase projects → fails on
#     IPv4 deploy targets (getaddrinfo ENOTFOUND / unreachable).
#   • Do NOT use the TRANSACTION pooler (port 6543): it drops the `options=-c search_path`
#     startup parameter the gateway pins, so every ccat.* table would appear missing.
# TLS required; the gateway auto-enables SSL for any non-local host.
DATABASE_URL=postgresql://postgres.wazutprwrhnabjfggghp:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (IPv6 only; needs host IPv6 or the Supabase IPv4 add-on):
#   postgresql://postgres:[YOUR-DB-PASSWORD]@db.wazutprwrhnabjfggghp.supabase.co:5432/postgres?sslmode=require
# Local-dev fallback (native Postgres, no Supabase — SSL auto-off for localhost):
#   postgresql://postgres:postgres@localhost:5432/ccat

# --- Supabase API (needed only when STORAGE_DRIVER=supabase is implemented) --
SUPABASE_URL=https://wazutprwrhnabjfggghp.supabase.co
# service_role is a SECRET and lives ONLY here in the gateway env — never in any client.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
# Publishable/anon key (safe; only a client using Supabase Auth would need it — CCAT does not):
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   (from Supabase → API keys)

# --- Gateway secrets --------------------------------------------------------
# PRODUCTION (NODE_ENV=production): the gateway REFUSES TO START unless BOTH of these are set to
# strong values. GATEWAY_HMAC_SECRET must be >=32 chars and not a placeholder; PIN_PEPPER is
# mandatory (no silent 'dev-pepper' fallback) and rejects known dev placeholders. Generate e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GATEWAY_HMAC_SECRET=change-me-in-prod
# IMPORTANT: the demo seed's admin password verifier was computed with this pepper.
# Keep it as 'dev-pepper' locally or the seeded admin logins won't work. In production, set a
# strong secret — but note it must MATCH the pepper the prod admin/PIN verifiers were created with
# (rotating the pepper invalidates every existing PIN/password hash).
PIN_PEPPER=dev-pepper

# --- Payments Phase 2 (entitlements + $50 gating) ---------------------------
# Master switch for membership gating. Default false. When false the gateway serves content exactly
# as today (a true no-op): no entitlement resolution, no locked flags, no upgrade_required 403s.
# Set to true ONLY on the payments preview/branch. Never commit it as true.
PAYMENTS_ENABLED=false

# --- Payments Phase 1 (Stripe Checkout) — gateway only, SERVER-SIDE secrets ---------------------
# All of these are read only when PAYMENTS_ENABLED=true. Never commit real values; set them in the
# Render (gateway) secret store. Test-mode keys for the preview; live-mode keys only for production.
# Secret key for the Stripe account (main account, acct_1UBsKMC2blhVy9Jd). Format: sk_test_... / sk_live_...
STRIPE_SECRET_KEY=
# Signing secret for the /v1/webhooks/stripe endpoint (from the Stripe webhook you create). whsec_...
STRIPE_WEBHOOK_SECRET=
# Server-owned tier -> Stripe Price ID map. The gateway builds Checkout from THESE only; a client price
# is never accepted. (Test-mode price IDs for the preview.)
STRIPE_PRICE_T50=
STRIPE_PRICE_T250=
STRIPE_PRICE_T500=
# CCAT web app origin used to build Checkout success/cancel URLs (…/plan?checkout=success|cancel).
# Reuses WEB_APP_ORIGIN (first entry if it is a comma-separated list). Must be the CCAT app, never conceptmastery.com.
# WEB_APP_ORIGIN is already defined below for CORS; the checkout route reads the same variable.

# --- CORS (production only) -------------------------------------------------
# In production the gateway serves TWO browser clients on DIFFERENT origins and pins an allowlist.
# Set BOTH (each accepts a comma-separated list); an unlisted origin is refused CORS headers.
#   ADMIN_WEB_ORIGIN — the Admin Console origin(s)      e.g. https://admin.conceptmastery.ca
#   WEB_APP_ORIGIN   — the student Web app origin(s)     e.g. https://app.conceptmastery.ca
# WEB_APP_ORIGIN is REQUIRED whenever the student web app calls the gateway from its own origin —
# do not omit it just because an older runbook mentioned only ADMIN_WEB_ORIGIN.
# ADMIN_WEB_ORIGIN=https://admin.conceptmastery.ca
# WEB_APP_ORIGIN=https://app.conceptmastery.ca

# --- Runtime ----------------------------------------------------------------
NODE_ENV=local
PORT=8080
HOST=0.0.0.0
# STORAGE_DRIVER=local   # 'supabase' once the Supabase Storage driver is implemented
